### 401 - Cannot log-in since password is wrong (username is OK)
POST {{baseUrl}}/auth/sign-in
Content-Type: application/json

{
  "username": "{{active_user}}",
  "password": "wrong_pass"
}

> {%
    client.test("Cannot log-in password is wrong", function() {
        client.assert(response.status === 401, "Response status is 401 since password is wrong");
    });
%}

### 401 - Cannot log-in since username is wrong (password is OK)
POST {{baseUrl}}/auth/sign-in
Content-Type: application/json

{
  "username": "wrong_username",
  "password": "{{active_pass}}"
}

> {%
    client.test("Cannot log-in password is wrong", function() {
        client.assert(response.status === 401, "Response status is 401 since password is wrong");
    });
%}

