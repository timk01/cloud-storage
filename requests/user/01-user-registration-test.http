@baseUrl = http://localhost:8080/api

### 201 - Successfully create a user
POST {{baseUrl}}/auth/sign-up
Content-Type: application/json

{
  "username": "conflict_user_{{$uuid}}",
  "password": "superPassword123"
}

> {%
    client.global.set("conflict_name", response.body.username);

    const runId = response.body.username.substring("conflict_user_".length);

    client.global.set("min_username", runId.substring(0, 3));
    client.global.set(
        "max_username",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" + runId
    );
    client.global.set("min_password_username", "tim1_" + runId);
    client.global.set("max_password_username", "tim2_" + runId);

    client.test("Successfully create a user", function() {
        client.assert(response.status === 201, "Response status is 201");
        const body = response.body;
        const expected = client.global.get("conflict_name");
        client.assert(body.username === expected, "Server should return name of user");
    });
%}

### 201 - Successfully create a user (with min length user's name)
POST {{baseUrl}}/auth/sign-up
Content-Type: application/json

{
  "username": "{{min_username}}",
  "password": "superPassword123"
}

> {%
    client.test("Successfully create a user", function() {
        client.assert(response.status === 201, "Response status is 201");
        const body = response.body;
        const expected = client.global.get("min_username");
        client.assert(body.username === expected, "Server should return name of user - username is short");
    });
%}

### 201 - Successfully create a user (with max length user's name)
