### 201 - Successfully create a user (with max password length)
POST {{baseUrl}}/auth/sign-up
Content-Type: application/json

{
  "username": "{{max_password_username}}",
  "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
}

> {%
    client.test("Successfully create a user", function() {
        client.assert(response.status === 201, "Response status is 201");
        const body = response.body;
        const expected = client.global.get("max_password_username");
        client.assert(body.username === expected, "Server should return name of user - password is long");
    });
%}

### 400 - User name is empty
POST {{baseUrl}}/auth/sign-up
Content-Type: application/json

{
  "username": "",
  "password": "abc123"
}

> {%
    client.test("Cannot create a user", function() {
        client.assert(response.status === 400, "Response status is 400 since name is empty ");
    });
%}

