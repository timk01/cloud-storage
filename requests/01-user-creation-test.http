### 409 - User name is already taken
POST {{baseUrl}}/auth/sign-up
Content-Type: application/json

{
  "username": "{{conflict_name}}",
  "password": "superPassword123"
}

> {%
    client.test("Cannot create a user", function() {
        client.assert(response.status === 409, "Response status is 409 since user name is already taken");
    });
%}

