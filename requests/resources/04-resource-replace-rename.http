### 200 - Successfully moved whole subdirectory from "gorgon_root/gorgon_archive/gorgon_files_${active_user}/" to a completely new path "folder9/folder10/gorgon_files_${active_user}/"
POST {{baseUrl}}/resource/move?from={{path_for_upload}}&to={{completely_new_path}}gorgon_files_{{active_user}}/

> {%
    client.test("Successfully moved whole directory to new path", function () {
        client.assert(response.status === 200, "Response status is 200");

        const body = response.body;

        const expected_parent_path = client.global.get("completely_new_path");
        const expected_folder_name = "gorgon_files_" + client.global.get("active_user");

        const moved_folder_path = expected_parent_path + expected_folder_name + "/";
        client.global.set("moved_folder_path", moved_folder_path);

        client.assert(body.path === expected_parent_path, "Directory should have correct parent path");
        client.assert(body.name === expected_folder_name, "Directory should have correct name");
        client.assert(body.type === "DIRECTORY", "Resource type should be DIRECTORY");
        client.assert(!("size" in body), "size field should not exist in directory object");
    });
%}

### Searched that all files (2) and subfoldiers (1) are properly moved to "foler9/folder10/gorgon_files_{active_user}/"
GET {{baseUrl}}/directory?path={{moved_folder_path}}

# So overall, such scheme after whole folder move
#
#folder9/
#└── folder10/
#    └── gorgon_files_{active_user}/ -> CHECKING THIS HERE
#        ├── gorgon.jpg
#        ├── description_gorgon.txt
#        └── different/
#            ├── file1.txt
#            └── file2.txt

> {%
    client.test("Moved directory should contain 2 files and 1 subdirectory", function () {
        client.assert(response.status === 200, "Response status is 200");

        const body = response.body;
        client.assert(Array.isArray(body), "Server should return an array");
        client.assert(body.length === 3, "Directory should contain exactly 3 resources");

        const expected_parent_path = client.global.get("moved_folder_path");

        const firstFile = body.find(item => item.name === "gorgon.jpg");
        client.assert(firstFile !== undefined, "gorgon.jpg should be found");
        client.assert(firstFile.path === expected_parent_path, "gorgon.jpg should have correct parent path");
        client.assert(typeof firstFile.size === "number" && firstFile.size > 0, "gorgon.jpg size should be > 0");
        client.assert(firstFile.type === "FILE", "gorgon.jpg type is FILE");

        const secondFile = body.find(item => item.name === "description_gorgon.txt");
        client.assert(secondFile !== undefined, "description_gorgon.txt should be found");
        client.assert(secondFile.path === expected_parent_path, "description_gorgon.txt should have correct parent path");
        client.assert(typeof secondFile.size === "number" && secondFile.size > 0, "description_gorgon.txt size should be > 0");
        client.assert(secondFile.type === "FILE", "description_gorgon.txt type is FILE");

        const differentFolder = body.find(item => item.name === "different");
        client.assert(differentFolder !== undefined, "different folder should be found");
        client.assert(differentFolder.path === expected_parent_path, "different folder should have correct parent path");
        client.assert(differentFolder.type === "DIRECTORY", "different type is DIRECTORY");
        client.assert(!("size" in differentFolder), "size field should not exist in directory object");
    });
%}

### Searched that all files (2) and subfoldiers (0) are properly moved into last dirctory "...different/"
GET {{baseUrl}}/directory?path={{moved_folder_path}}different/

# So overall, such scheme after whole folder move
#
#folder9/
#└── folder10/
#    └── gorgon_files_{active_user}/
#        ├── gorgon.jpg
#        ├── description_gorgon.txt
#        └── different/ -> CHECKING THIS HERE
#            ├── file1.txt
#            └── file2.txt

> {%
    client.test("Nested directory should contain both files", function () {
        client.assert(response.status === 200, "Response status is 200");

        const body = response.body;
        client.assert(Array.isArray(body), "Server should return an array");
        client.assert(body.length === 2, "Directory should contain exactly 2 resources");

        const expected_parent_path = client.global.get("moved_folder_path") + "different/";

        const firstFile = body.find(item => item.name === "file1.txt");
        client.assert(firstFile !== undefined, "file1.txt should be found");
        client.assert(firstFile.path === expected_parent_path, "file1.txt should have correct parent path");
        client.assert(typeof firstFile.size === "number" && firstFile.size > 0, "file1.txt size should be > 0");
        client.assert(firstFile.type === "FILE", "file1.txt type is FILE");

        const secondFile = body.find(item => item.name === "file2.txt");
        client.assert(secondFile !== undefined, "file2.txt should be found");
        client.assert(secondFile.path === expected_parent_path, "file2.txt should have correct parent path");
        client.assert(typeof secondFile.size === "number" && secondFile.size > 0, "file2.txt size should be > 0");
        client.assert(secondFile.type === "FILE", "file2.txt type is FILE");
    });
%}

