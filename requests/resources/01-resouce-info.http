@baseUrlApi = http://localhost:8080/api
@baseUrl = http://localhost:8080/api

@regUser = timur_auto
@regPass = superPassword123

@test_folder_to_check = folder1/folder2/folder3/
@test_folder_to = folder9/folder10/

### 401 - Failed to get resourse info since user wasn't authorized (no cookies provided!)
# @no-cookie-jar
GET {{baseUrl}}/resource?path={{test_folder_to_check}}

> {%
    client.test("Cannot get info of resource", function () {
        client.assert(response.status === 401, "Response status is 401 since user is not authorized");
    });
%}

### Prereg (user creation) - method is needed for success test of prelog (1 pre-phase)
POST {{baseUrlApi}}/auth/sign-up
Content-Type: application/json

{
  "username": "timur_{{$timestamp}}",
  "password": "{{regPass}}"
}

> {%
    client.global.set("active_user", response.body.username);
    client.global.set("active_pass", "superPassword123");
%}

### Prelog (user authorization) - method is needed for success test of prelog (2 pre-phase)
POST {{baseUrlApi}}/auth/sign-in
Content-Type: application/json

{
  "username": "{{active_user}}",
  "password": "{{active_pass}}"
}

> {%
    client.test("Successfully logged-in", function () {
        client.assert(response.status === 200, "Response status is 200");
        const body = response.body;
        const expected_user = client.global.get("active_user")
        client.assert(body.username === expected_user, "Server should return name of user");
    });

    client.global.set(
        "path_for_upload",
        "gorgon_root/gorgon_archive/gorgon_files_" +
        client.global.get("active_user") +
        "/"
    );
%}

### Successfully uploaded TWO files (picture and text file) to a previosly created folder (3 pre-phase)
# Path to files (passed in query, say, POST {{baseUrl}}/resource?path=folder1/)
POST {{baseUrl}}/resource?path={{path_for_upload}}
Content-Type: multipart/form-data; boundary=boundary

# Part №1 of multipart-File (picture): several file will be converted into files
--boundary
Content-Disposition: form-data; name="object"; filename="gorgon.jpg"
Content-Type: image/jpeg

< ./docs/gorgon.jpg
--boundary
# Part №2 of multipart-File (text file)
Content-Disposition: form-data; name="object"; filename="description_gorgon.txt"
Content-Type: text/plain

< ./docs/description_gorgon.txt
--boundary

> {%
    client.test("Successfully uploaded two files into folder", function () {

        client.assert(response.status === 201, "Response status is 201");
        const body = response.body;
        client.assert(Array.isArray(body), "Server should return an array");
        client.assert(body.length === 2, "Folder should contain exactly 2 resources");

        const expected_parent_path = client.global.get("path_for_upload");

        const firstFile = body.find(item => item.name === "gorgon.jpg");
        //and it's not empty
        client.assert(firstFile !== undefined, "WE have firstFile element in array");
        //hence, we can get some info from this array element (say, array[0]): such as path, name, size and type
        client.assert(firstFile.path === expected_parent_path, "firstFile should have correct parent path");
        client.assert(firstFile.name === "gorgon.jpg", "firstFile name is gorgon.jpg");
        client.assert(typeof firstFile.size === "number" && firstFile.size > 0, "firstFile size field should be > 0");
        client.assert(firstFile.type === "FILE", "firstFile type is file");

        const secondFile = body.find(item => item.name === "description_gorgon.txt");
        client.assert(secondFile !== undefined, "WE have secondFile element in array");
        //hence, we can get some info from this array element (say, array[0]): such as path, name, size and type
        client.assert(secondFile.path === expected_parent_path, "secondFile should have correct parent path");
        client.assert(secondFile.name === "description_gorgon.txt", "secondFile name is description_gorgon.txt");
        client.assert(typeof secondFile.size === "number" && secondFile.size > 0, "secondFile size field should be > 0");
        client.assert(secondFile.type === "FILE", "secondFile type is file");
    });
%}

### Successfully created a folder "unnamed_${active_user}" to a previously created folder "gorgon_archive/" (4 pre-phase)
POST {{baseUrl}}/directory?path=gorgon_root/gorgon_archive/unnamed_{{active_user}}/

> {%
    client.test("Successfully created a folder", function () {
        client.assert(response.status === 201, "Response status is 201");

        const body = response.body;
        const expected_folder_name = "unnamed_" + client.global.get("active_user");

        client.assert(body.path === "gorgon_root/gorgon_archive/", "Folder should have correct parent path");
        client.assert(body.name === expected_folder_name, "Folder should have correct name");
        client.assert(body.type === "DIRECTORY", "Folder type should be DIRECTORY");
    });
    client.global.set(
        "unnamed_folder_path",
        "gorgon_root/gorgon_archive/unnamed_" +
        client.global.get("active_user") +
        "/"
    );
%}

### Successfully uploaded files ("file1.txt", "file2.txt") to new folder (".../different/") (5 pre-phase)
POST {{baseUrl}}/resource?path=gorgon_root/gorgon_archive/gorgon_files_{{active_user}}/different/
Content-Type: multipart/form-data; boundary=boundary

# Part №1
--boundary
Content-Disposition: form-data; name="object"; filename="file1.txt"
Content-Type: text/plain

< ./docs/file1.txt
--boundary

# Part №2
--boundary
Content-Disposition: form-data; name="object"; filename="file2.txt"
Content-Type: text/plain

< ./docs/file2.txt
--boundary--

> {%
    client.test("Successfully uploaded 2 files into folder", function () {
        client.assert(response.status === 201, "Response status is 201");

        const body = response.body;
        client.assert(Array.isArray(body), "Server should return an array");
        client.assert(body.length === 2, "Response should contain exactly 2 resources");

        const expected_parent_path = "gorgon_root/gorgon_archive/gorgon_files_" + client.global.get("active_user") + "/different/";
        client.global.set("different_folder_path", expected_parent_path);

        const firstFile = body.find(item => item.name === "file1.txt");
        client.assert(firstFile !== undefined, "WE have firstFile element in array");
        client.assert(firstFile.path === expected_parent_path, "firstFile should have correct parent path");
        client.assert(firstFile.name === "file1.txt", "firstFile name is file1.txt");
        client.assert(typeof firstFile.size === "number" && firstFile.size > 0, "firstFile size field should be > 0");
        client.assert(firstFile.type === "FILE", "firstFile type is FILE");

        const secondFile = body.find(item => item.name === "file2.txt");
        client.assert(secondFile !== undefined, "WE have secondFile element in array");
        client.assert(secondFile.path === expected_parent_path, "secondFile should have correct parent path");
        client.assert(secondFile.name === "file2.txt", "secondFile name is file2.txt");
        client.assert(typeof secondFile.size === "number" && secondFile.size > 0, "secondFile size field should be > 0");
        client.assert(secondFile.type === "FILE", "secondFile type is FILE");
    });
%}

### Successfully created EMPTY folder inside gorgon_files_${active_user} (6 pre-phase) -> with preparation pathes for upload for file/folder!
POST {{baseUrl}}/directory?path=gorgon_root/gorgon_archive/gorgon_files_{{active_user}}/empty_folder_{{active_user}}/

# So overall, such scheme fnally:
#
#gorgon_root/ ------------------------------------> here to check an folder without parent(2 check)
#└── gorgon_archive/ -----------------------------> here to check WHOLE folder (3 check)
#    ├── unnamed_${active_user}/
#    └── gorgon_files_${active_user}/
#        ├──empty_folder_${active_user}/
#        ├── gorgon.jpg
#        ├── description_gorgon.txt
#        └── different/
#            ├── file1.txt
#            └── file2.txt -----------------------> here to check a single FILE (1 check)

> {%
    client.test("Successfully created empty folder", function () {
        client.assert(response.status === 201, "Response status is 201");

        const body = response.body;

        const expected_parent_path = "gorgon_root/gorgon_archive/gorgon_files_" + client.global.get("active_user") + "/";

        const expected_folder_name = "empty_folder_" + client.global.get("active_user");

        client.assert(body.path === expected_parent_path, "Folder should have correct parent path");
        client.assert(body.name === expected_folder_name, "Folder should have correct name");
        client.assert(body.type === "DIRECTORY", "Folder type should be DIRECTORY");
    });

    client.global.set(
        "path_for_file_info",
        "gorgon_root/gorgon_archive/gorgon_files_" +
        client.global.get("active_user") +
        "/different/file1.txt"
    );

    client.global.set(
        "path_for_root_folder",
        "gorgon_root/"
    );

    client.global.set(
        "path_for_other_folder_info",
        "gorgon_root/gorgon_archive/"
    );
%}

### 200 - Successfully got resourse info (.../different/file1.txt)
GET {{baseUrl}}/resource?path={{path_for_file_info}}

> {%
    client.test("Successfully got resource info (file) ", function () {
        client.assert(response.status === 200, "Response status is 200");

        const body = response.body;

        const expected_parent_path = "gorgon_root/gorgon_archive/gorgon_files_"
            + client.global.get("active_user") + "/" + "different/";

        client.assert(body.path === expected_parent_path, "file should have correct parent path");
        client.assert(body.name === "file1.txt", "file name is file1.txt");
        client.assert(typeof body.size === "number" && body.size > 0, "file size field should be > 0");
        client.assert(body.type === "FILE", "file type is FILE");
    });
%}

### 200 - Successfully got resourse info - root folder (gorgon_root/)
GET {{baseUrl}}/resource?path={{path_for_root_folder}}

> {%
    client.test("Successfully got resource info (directory)", function () {
        client.assert(response.status === 200, "Response status is 200");

        const body = response.body;

        const expected_parent_path = "";

        client.assert(body.path === expected_parent_path, "Server should return parent path (no parent now");
        client.assert(body.name.startsWith("gorgon_root"), "Server should return name");
        client.assert(body.type === "DIRECTORY", "Server should return type (directory)");
    });
%}

### 200 - Successfully got resourse info - other folder (gorgon_root/gorgon_archive/)
GET {{baseUrl}}/resource?path={{path_for_other_folder_info}}

> {%
    client.test("Successfully got resource info (folder) ", function () {
        client.assert(response.status === 200, "Response status is 200");

        const body = response.body;

        const expected_parent_path = "gorgon_root/";

        client.assert(body.path === expected_parent_path, "Server should return parent path");
        client.assert(body.name.startsWith("gorgon_archive"), "Server should return name");
        client.assert(body.type === "DIRECTORY", "Server should return type (directory)");
    });
%}

